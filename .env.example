# Environment variables for Talktor
# Copy this file to `.env` at the repository root and adjust values as needed.
# These defaults are suitable for local development and simple production on localhost.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=talktor

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@local.test
PGADMIN_DEFAULT_PASSWORD=admin

# --- OpenAI ---
# IMPORTANT: Set your OpenAI API Key to enable conversation, STT/TTS, and feedback generation.
# Example: sk-proj-... or any valid key. Do NOT commit real keys to source control.
OPENAI_API_KEY=your_openai_api_key_here
